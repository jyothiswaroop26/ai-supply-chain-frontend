# AI Supply Chain Frontend - API Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# API Environment Settings
# ============================================================================
# Options: local, development, staging, production, mock
API_ENV=mock

# API Server Configuration
API_BASE_URL=http://localhost:8000
API_VERSION=v1

# ============================================================================
# Authentication
# ============================================================================
# Set to true to enable authentication
API_USE_AUTH=false

# API Key for authentication (if using key-based auth)
# API_KEY=your-api-key-here

# Bearer token for authentication (if using token-based auth)
# API_TOKEN=your-bearer-token-here

# ============================================================================
# Timeout and Retry Configuration
# ============================================================================
# Request timeout in seconds
API_TIMEOUT=30

# Maximum number of retries for failed requests
API_MAX_RETRIES=3

# Delay between retries in seconds
API_RETRY_DELAY=1.0

# ============================================================================
# Caching Configuration
# ============================================================================
# Enable response caching
API_CACHE_ENABLED=true

# Cache time-to-live in seconds
API_CACHE_TTL=300

# Batch size for bulk operations
API_BATCH_SIZE=100

# ============================================================================
# Features and Debug
# ============================================================================
# Simulate network delays (useful for development)
API_SIMULATE_DELAY=true

# Enable verbose logging for debugging
API_VERBOSE_LOGGING=false

# Use mock data instead of real API (for development/testing)
API_MOCK_MODE=true

# ============================================================================
# Application Settings
# ============================================================================
STREAMLIT_CLIENT_THEME=light
STREAMLIT_LOGGER_LEVEL=info

# ============================================================================
# Optional: OpenAI Configuration (for AI features)
# ============================================================================
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-4

# ============================================================================
# Optional: Database Configuration (if using persistent storage)
# ============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/supply_chain_db
# DATABASE_POOL_SIZE=10
